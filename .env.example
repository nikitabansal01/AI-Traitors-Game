# Copy to `.env.local` (Next) and `.dev.vars` (Wrangler local worker).
# Never commit real keys. Never paste keys into chat.

# Local: wrangler listens on 1999. Production: your-worker.workers.dev (no https://)
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Required for LLM AI players (otherwise heuristic fallback)
# Put the same key in `.dev.vars` for local realtime, and:
#   npx wrangler secret put OPENAI_API_KEY
# for production Workers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
